<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<Format>opencover</Format>
					<Exclude>
						<!--Assembly Exclude-->
						[*]Microsoft.*,
						[*]System.*,
						[*]Api.Test.*,
						Api.Test.*
						[*]CQRS.AutoGenerated.*
					</Exclude>
					<ExcludeByFile>
						<!--File Exclude-->
						**/Program.cs,
						**/*.g.cs,
						**/AppHost.cs
					</ExcludeByFile>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>